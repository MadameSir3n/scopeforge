    "categories": [
      "web",
      "crypto",
      "forensics",
      "reverse_engineering",
      "privilege_escalation",
      "network",
      "osint",
      "miscellaneous"
    ]
  },
  "metadata": {
    "created_by": "TryHackMe Team",
